# Deployment values and secrets only. Everything else (signal leverage / margin, trading
# switches, testnet, poll interval, fee, timeouts, parser keywords, channel, bot, ...) is
# edited on the Settings page (sidebar) and stored in the database.
#
# Upgrading from an older .env: run `python manage.py migrate` once. It imports the old values
# (SIGNAL_*, TRADING_*, FORWARD_TEST_*, BINANCE_TESTNET, TELEGRAM_LISTENER_ENABLED,
# CRYPTO_SIGNALS_CHANNEL, CRYPTO_SIGNAL_SENDER_BOT) into Settings. After that you can delete
# those lines from .env; they are never read again.

DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost

DATABASE_NAME=telegram_binance_automation
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=telegram_listener

BINANCE_API_KEY=
BINANCE_API_SECRET=
